# Copy to .env and set the Django secret key and PostgreSQL password.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=Circlefund
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REGISTRATION_THROTTLE_RATE=5/hour
LOGIN_IP_THROTTLE_RATE=30/min
LOGIN_ACCOUNT_THROTTLE_RATE=10/min
# Set a shared Redis cache for authentication limits across workers.
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
# Set only when requests arrive through a known number of trusted proxies.
# DJANGO_NUM_PROXIES=1
